# Pilih "mock" agar project berjalan tanpa backend, atau "supabase" untuk API production.
NEXT_PUBLIC_WEDDING_DATA_ADAPTER=mock
NEXT_PUBLIC_SITE_URL=https://undangi.my.id
# Supabase project URL. NEXT_PUBLIC value disediakan untuk tooling; UI tidak mengakses tabel langsung.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=

# Server-only. Jangan pernah memakai prefix NEXT_PUBLIC atau commit nilai asli.
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
